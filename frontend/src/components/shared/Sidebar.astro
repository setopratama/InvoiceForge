---
import { 
	LayoutDashboard, 
	Receipt, 
	Users, 
	UserCog, 
	Building,
	Settings,
	PlusCircle
} from 'lucide-preact';

const menuItems = [
	{ name: 'Dashboard', icon: LayoutDashboard, href: '/' },
	{ name: 'Invoices', icon: Receipt, href: '/invoice' },
	{ name: 'Clients', icon: Users, href: '/client' },
	{ name: 'PIC Management', icon: UserCog, href: '/pic' },
	{ name: 'Companies', icon: Building, href: '/settings/companies' },
];

const pathname = new URL(Astro.request.url).pathname;
---

<aside class="w-64 border-r border-stone-200 bg-[#FAFAF9] flex flex-col hidden md:flex">
	<div class="p-6">
		<a 
			href="/invoice/create" 
			class="flex items-center justify-center gap-2 bg-stone-900 text-white py-3 px-4 text-sm font-semibold uppercase tracking-wider hover:bg-stone-800 transition-colors"
		>
			<PlusCircle className="w-4 h-4" />
			New Invoice
		</a>
	</div>
	
	<nav class="flex-1 px-4 space-y-1">
		{menuItems.map((item) => {
			const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
			return (
				<a
					href={item.href}
					class={`flex items-center gap-3 px-4 py-3 text-sm font-medium transition-colors ${
						isActive 
							? 'bg-stone-200 text-stone-900' 
							: 'text-stone-500 hover:text-stone-900 hover:bg-stone-100'
					}`}
				>
					<item.icon className="w-5 h-5" />
					{item.name}
				</a>
			);
		})}
	</nav>
	
	<div class="p-4 border-t border-stone-200">
		<a 
			href="/settings" 
			class={`flex items-center gap-3 px-4 py-3 text-sm font-medium transition-colors ${
				pathname === '/settings' 
					? 'bg-stone-200 text-stone-900' 
					: 'text-stone-500 hover:text-stone-900 hover:bg-stone-100'
			}`}
		>
			<Settings className="w-5 h-5" />
			Settings
		</a>
	</div>
</aside>
